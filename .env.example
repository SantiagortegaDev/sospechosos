# Portal (publishable key — safe for browser bundle)
NEXT_PUBLIC_PORTAL_API_KEY=pk_your_publishable_key

# Groq (server-only — get one at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key

# Portal secret key (server-only — for webhook signature verification)
PORTAL_SECRET_KEY=sk_your_secret_key
